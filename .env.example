# PostHog browser analytics
# Project token from PostHog > Settings > Project. Safe to expose client-side.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_posthog_project_token
# PostHog managed reverse proxy for this project (EU region behind p.dodomains.dev).
# Read at build time by next.config.ts rewrites, so it must be set before `next build`.
NEXT_PUBLIC_POSTHOG_HOST=https://p.dodomains.dev

# name.com Core API credentials for live availability checks.
# Production tokens: https://www.name.com/account/settings/api
# Without these, results fall back to the registered-domains snapshot and
# show "Couldn't verify" instead of "Available".
NAME_COM_USERNAME=your-namecom-username
NAME_COM_TOKEN=your-namecom-api-token
